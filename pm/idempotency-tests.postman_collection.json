  "item": [
    {
      "name": "1. РЕГИСТРАЦИЯ И ВХОД ПОЛЬЗОВАТЕЛЯ",
      "item": [
        {
          "name": "1.1. Регистрация пользователя",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Код статуса 201 — пользователь создан', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = JSON.parse(pm.request.body.raw);",
                  "pm.environment.set('testEmail', body.email);",
                  "pm.environment.set('testPassword', body.password);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"firstName\": \"Тестовый\",\n  \"lastName\": \"Пользователь\",\n  \"phone\": \"+7900{{randomInt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "1.2. Вход пользователя и получение JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Код статуса 200 — вход выполнен', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('В ответе присутствует jwt', function () {",
                  "    pm.expect(jsonData).to.have.property('jwt');",
                  "    pm.expect(jsonData.jwt).to.exist;",
                  "    pm.environment.set('userToken', jsonData.jwt);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
