    {
      "name": "2. БАЗОВАЯ ИДЕМПOTЕНТНОСТЬ",
      "item": [
        {
          "name": "2.1. Создание заказа с ключом IDEMPOTENCY-TEST-001 (первый запрос)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Код статуса 202 — заказ принят', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('В ответе присутствует id заказа', function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.exist;",
                  "});",
                  "pm.test('Статус заказа PENDING', function () {",
                  "    pm.expect(jsonData.status).to.eql('PENDING');",
                  "});",
                  "pm.environment.set('firstOrderId', jsonData.id);",
                  "pm.environment.set('firstOrderStatus', jsonData.status);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "043d7a44-5f68-4f0f-9263-f285728ea6a7",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"3500\",\n  \"currency\": \"RUB\",\n  \"itemSku\": \"{{drillSku}}\",\n  \"quantity\": 1,\n  \"deliverySlot\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "api", "v1", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "2.2. Повторный запрос с тем же ключом IDEMPOTENCY-TEST-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Код статуса 200 — возвращён существующий заказ', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Возвращён тот же идентификатор заказа', function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('firstOrderId'));",
                  "});",
                  "pm.test('Статус заказа не изменился', function () {",
                  "    pm.expect(jsonData.status).to.eql(pm.environment.get('firstOrderStatus'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "043d7a44-5f68-4f0f-9263-f285728ea6a7",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"3500\",\n  \"currency\": \"RUB\",\n  \"itemSku\": \"{{drillSku}}\",\n  \"quantity\": 1,\n  \"deliverySlot\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "api", "v1", "orders"]
            }
          },
          "response": []
        }
      ]
